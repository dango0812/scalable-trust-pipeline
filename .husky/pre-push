# Changes reach main only through pull requests: refuse direct pushes to main,
# and refuse pushing branches whose names break the convention.
# git feeds one line per ref: <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main | refs/heads/master)
      echo "x Direct push to '${remote_ref#refs/heads/}' is blocked. Push a branch and open a pull request." >&2
      exit 1
      ;;
    refs/heads/*)
      # Deleting a remote branch sends "(delete)" as the local ref; its name needs no check.
      [ "$local_ref" = "(delete)" ] && continue
      sh scripts/check-branch-name.sh "${remote_ref#refs/heads/}" || exit 1
      ;;
  esac
done
